package waui:ui;

/// The world shared between a waui component (UI + logic) and a host (a
/// renderer).
///
/// The component owns all state. It exports its current widget tree via
/// `view` (a flat, depth-first pre-ordered node list) and the diff of that
/// tree via `changes`. The host bootstraps from `view` (a full snapshot)
/// and applies successive `changes` to its retained copy. A host may ignore
/// `changes` and re-query `view` after every event: `view` is always the
/// full tree, so this stays correct. The diff is an optimization, opt-in
/// per host.
///
/// The host calls `on-tick` at the period the component requests with
/// `schedule` (0 = never) and provides a `now` clock the component can
/// poll. User events flow the other way: `on-click` for activations and
/// `on-text` for text-input edits.
///
/// The windowing functions are for components that run *other* components —
/// the desktop: the icon grid, the menu bar, and the set of open windows.
/// The component owns the *logical* state — which demos are open, the grid,
/// the menu bar — and exports it via `view`/`changes`, as any component
/// does. It *requests* window operations through the `open-window` import;
/// the host owns the *presentation* — the chrome, the pixel geometry, the
/// z-order — and echoes user actions back through `on-double-click` (a node
/// was activated) and `on-window-close` (a window was closed by the user).
/// Drag, resize, and raise are host-internal: the host draws the chrome and
/// handles its own pointer events, reporting only the close.
///
/// Window references are flat handles (a `u32` the host assigns) and string
/// `src`s, in the wasi:filesystem shape: a host-provided registry
/// (`list-demos`, its `preopens`), an open by string (`open-window`, its
/// `open-at`), and a `result` error model.
///
/// A host that cannot run other components returns an empty registry from
/// `list-demos` and `not-found` from `open-window`; a component that
/// manages no windows ignores `on-double-click` and `on-window-close`.
world app {
  use widget.{node, mutation};

  /// The component's current UI (see `widget` for the flat-list contract).
  export view: func() -> list<node>;

  /// The nodes changed since the host last saw the tree (via `view` or
  /// `changes`); empty when nothing did. A component that has never
  /// exported its tree reports every node as `changed`, so a host may
  /// bootstrap from `changes` alone.
  export changes: func() -> list<mutation>;

  /// The widget with the given id was activated (e.g. clicked).
  export on-click: func(id: u32);

  /// The widget with the given id is a text input whose content is now
  /// `text`: the host's whole current buffer, after the user's latest edit.
  /// The component is the source of truth for the buffer — it may echo it,
  /// transform it, or ignore the edit — and reports the result in its tree.
  export on-text: func(id: u32, text: string);

  /// The host calls this at the component's scheduled period, so
  /// time-based UIs can advance.
  export on-tick: func();

  /// The node with the given id was double-activated. A host whose input
  /// model has no double-click never emits this, as it may ignore
  /// `schedule`.
  export on-double-click: func(id: u32);

  /// The window with the given handle was closed by the user (via the
  /// host's chrome): the component drops it from its open set.
  export on-window-close: func(window: u32);

  /// Request a refresh period, in ms: the host wakes the component
  /// (`on-tick`, then `changes`) at that period until the component
  /// schedules a new one; 0 cancels. A host may ignore the request — a
  /// time-based UI then advances only on events — because the diff stays
  /// correct either way.
  import schedule: func(period: u64);

  /// The host's clock, in milliseconds (arbitrary, monotonic epoch).
  import now: func() -> u64;

  /// A demo the host can run in a window: its label, its icon, the module
  /// the host instantiates for it, and its default window size.
  ///
  /// The `icon` and the `src` are paths or asset names the host resolves
  /// (the icon to pixels, as an image's `src`; the `src` to a component).
  /// The `default-*` sizes are in the host's units; `0` leaves them to the
  /// host's default, as with the style and width tokens.
  record demo {
    /// The demo's display name (e.g. "Counter").
    name: string,
    /// The producer language (e.g. "Rust").
    lang: string,
    /// The icon's path or asset name.
    icon: string,
    /// The module the host instantiates to run this demo.
    src: string,
    /// The window's default width, in the host's units.
    default-width: u32,
    /// The window's default height, in the host's units.
    default-height: u32,
  }

  /// Why `open-window` failed.
  enum error {
    /// The host does not recognize the `src`: it is not a demo it can run.
    not-found,
    /// The requested geometry is invalid (a non-positive size, or a
    /// placement the host cannot honor).
    invalid,
  }

  /// The demos the host can run, for the component to build its grid. The
  /// host-provided registry, like wasi:filesystem's `preopens`; a host that
  /// runs no demos returns an empty list.
  import list-demos: func() -> list<demo>;

  /// Open a window running the demo at `src`, titled `title`, placed at
  /// `(x, y)` with size `(w, h)` in the host's units (`0` leaves a
  /// dimension to the host's default). Returns the host's window handle.
  import open-window: func(
      src: string,
      title: string,
      x: u32,
      y: u32,
      w: u32,
      h: u32,
    ) -> result<u32, error>;
}
