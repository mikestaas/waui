package waui:ui;

/// The world shared between a desktop component (the icon grid, the menu
/// bar, and the set of open windows) and a host that can run *other*
/// components inside windows.
///
/// This is the multi-component host's world: unlike `app` (one component,
/// one tree), a desktop host composites the desktop component's tree (the
/// grid and menu bar) with the windows it opens, each window running an
/// embedded demo component on the `app` world.
///
/// The desktop component owns the *logical* state — which demos are open,
/// the grid, the menu bar — and exports it via `view`/`changes`, exactly as
/// on the `app` world. It *requests* window operations through the `open-
/// window` import; the host owns the *presentation* — the chrome, the pixel
/// geometry, the z-order — and echoes user actions back through `on-double-
/// click` (a tile was activated) and `on-window-close` (a window was closed
/// by the user). Drag, resize, and raise are host-internal: the host draws
/// the chrome and handles its own pointer events, reporting only the close.
///
/// Window references are flat handles (a `u32` the host assigns) and string
/// `src`s, in the wasi:filesystem shape: a host-provided registry
/// (`list-demos`, its `preopens`), an open by string (`open-window`, its
/// `open-at`), and a `result` error model.
world desktop {
  use widget.{node, mutation};

  /// A demo the desktop can open in a window: its label, its icon, the
  /// module the host instantiates for it, and its default window size.
  ///
  /// The `icon` and the `src` are paths or asset names the host resolves
  /// (the icon to pixels, as an image's `src`; the `src` to a component).
  /// The `default-*` sizes are in the host's units; `0` leaves them to the
  /// host's default, as with the style and width tokens.
  record demo {
    /// The demo's display name (e.g. "Counter").
    name: string,
    /// The producer language (e.g. "Rust").
    lang: string,
    /// The icon's path or asset name.
    icon: string,
    /// The module the host instantiates to run this demo.
    src: string,
    /// The window's default width, in the host's units.
    default-width: u32,
    /// The window's default height, in the host's units.
    default-height: u32,
  }

  /// Why `open-window` failed.
  enum error {
    /// The host does not recognize the `src`: it is not a demo it can run.
    not-found,
    /// The requested geometry is invalid (a non-positive size, or a
    /// placement the host cannot honor).
    invalid,
  }

  /// The demos the host can run, for the component to build its grid. The
  /// host-provided registry, like wasi:filesystem's `preopens`.
  import list-demos: func() -> list<demo>;

  /// Open a window running the demo at `src`, titled `title`, placed at
  /// `(x, y)` with size `(w, h)` in the host's units (`0` leaves a dimension
  /// to the host's default). Returns the host's window handle.
  import open-window: func(
      src: string,
      title: string,
      x: u32,
      y: u32,
      w: u32,
      h: u32,
    ) -> result<u32, error>;

  /// The component's current UI (the grid and menu bar; see `widget` for the
  /// flat-list contract). The windows are host-drawn, not part of this tree.
  export view: func() -> list<node>;

  /// The nodes changed since the host last saw the tree (via `view` or
  /// `changes`); empty when nothing did. (See the `app` world for the diff
  /// contract.)
  export changes: func() -> list<mutation>;

  /// The tile with the given id was activated (double-clicked): the component
  /// opens the demo it represents. The host also maps Enter/Space on a
  /// focused tile to this.
  export on-double-click: func(id: u32);

  /// The window with the given handle was closed by the user (via the host's
  /// chrome): the component drops it from its open set.
  export on-window-close: func(window: u32);
}
