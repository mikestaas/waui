package waui:ui;

/// A minimal, renderer-agnostic widget tree, encoded as a **flat list of
/// nodes** in depth-first pre-order: every parent precedes its children, and
/// siblings appear in visual order.
///
/// WIT types may not be recursive, so instead of a tree type that refers to
/// itself, the tree is a `list` whose nodes carry a `parent` id, and the
/// host rebuilds the tree.
///
/// **Identity.** A node's `id` is its handle: what `on-click` targets and
/// what the `changes` diff channel keys on. A node that is never clicked,
/// diffed, or removed may omit its `id`. But a node must *have* an id if it
/// has children (they name it in their `parent` field) or if its own fate
/// matters — a `removed(id)` needs an id to delete by, and an id-less node
/// is *unaddressable*: a component must not report it in a `changes` diff,
/// and a host may ignore such a mutation.
interface widget {
  /// A semantic color. Each host maps these onto its own palette (ANSI
  /// colors, theme colors, CSS variables); a host that cannot express a
  /// token renders without it.
  enum color {
    /// Default foreground for the host's palette.
    neutral,
    /// The host's highlight/accent tone.
    accent,
    /// Good / success / increasing.
    positive,
    /// Bad / error / decreasing.
    negative,
    /// Caution / in-progress.
    warning,
  }

  /// A semantic text size, mapped by each host to its own scale.
  enum size {
    small,
    medium,
    large,
  }

  /// Per-node style: color + size. Everything else (borders, padding,
  /// backgrounds, focus) is a host concern.
  record style {
    color: color,
    size: size,
  }

  /// A piece of text.
  record text {
    id: option<u32>,
    parent: option<u32>,
    content: string,
    style: style,
  }

  /// A clickable button.
  record button {
    id: option<u32>,
    parent: option<u32>,
    label: string,
    style: style,
  }

  /// A horizontal or vertical container.
  ///
  /// (Named `container` rather than `box`: the latter would clash with
  /// `std::boxed::Box` in generated Rust bindings.)
  ///
  /// Containers carry layout only — no `style` field; how a host decorates
  /// one is a host concern, like focus.
  ///
  /// A container's `id` is *required in practice*: its children name it in
  /// their `parent` field, and the host rebuilds the tree from that. A
  /// host that sees a child with a parent it does not have will treat the
  /// child as a root.
  record container {
    id: option<u32>,
    parent: option<u32>,
    direction: direction,
  }

  enum direction {
    row,
    column,
  }

  variant node {
    text(text),
    button(button),
    container(container),
  }

  /// One entry of a `changes` diff (see the `app` world): what is new for
  /// the host since it last saw the tree.
  ///
  /// A `changed` node is keyed by its `id`: with the same parent as the
  /// retained copy, the host replaces it in place; if the component
  /// re-parents it (same id, new parent), the host moves it just after the
  /// new parent (past any of its own descendants still in the list). A
  /// `removed` id deletes a node — and, if it is a container, the whole
  /// subtree under it. Deeper restructuring is composed from these: a
  /// component that moves a container should remove the subtree and re-add
  /// it, since the flat pre-order list gives each retained node a stable
  /// home. A `changed` mutation for an id-less node is unaddressable (see
  /// the identity note above): hosts may ignore it.
  variant mutation {
    changed(node),
    removed(u32),
  }
}
