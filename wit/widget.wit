package waui:ui;

/// A minimal, renderer-agnostic widget tree, encoded as a **flat list of
/// nodes** in depth-first pre-order: every parent precedes its children, and
/// siblings appear in visual order.
///
/// WIT types may not be recursive, so instead of a tree type that refers to
/// itself, the tree is a `list` whose nodes carry a `parent` id, and the
/// host rebuilds the tree.
///
/// **Identity.** A node's `id` is its handle: what `on-click` and `on-text`
/// target, and what the `changes` diff channel keys on. A node that is never
/// clicked, edited, diffed, or removed may omit its `id`. But a node must
/// *have* an id if it has children (they name it in their `parent` field) or
/// if its own fate matters — a `removed(id)` needs an id to delete by, and
/// an id-less node is *unaddressable*: a component must not report it in a
/// `changes` diff, and a host may ignore such a mutation.
interface widget {
  /// A semantic color. Each host maps these onto its own palette (ANSI
  /// colors, theme colors, CSS variables); a host that cannot express a
  /// token renders without it.
  enum color {
    /// Default foreground for the host's palette.
    neutral,
    /// The host's highlight/accent tone.
    accent,
    /// Good / success / increasing.
    positive,
    /// Bad / error / decreasing.
    negative,
    /// Caution / in-progress.
    warning,
  }

  /// A semantic text size, mapped by each host to its own scale.
  enum size {
    small,
    medium,
    large,
  }

  /// Per-node style: color + size. Everything else (borders, padding,
  /// backgrounds, focus) is a host concern.
  record style {
    color: color,
    size: size,
  }

  /// A piece of text.
  record text {
    id: option<u32>,
    parent: option<u32>,
    content: string,
    style: style,
  }

  /// A clickable button.
  record button {
    id: option<u32>,
    parent: option<u32>,
    label: string,
    style: style,
  }

  /// A single-line text input. The host renders it as an editable field and
  /// reports the user's edits through the `app` world's `on-text` (see there
  /// for the buffer contract). `content` is the text as the component last
  /// saw it. `width` is the field's width in characters, mapped by each host
  /// to its own units (terminal columns, pixels, CSS `ch`); `0` leaves the
  /// width to the host's default, as with the style tokens.
  record input {
    id: option<u32>,
    parent: option<u32>,
    content: string,
    style: style,
    width: u32,
  }

  /// A horizontal or vertical container.
  ///
  /// (Named `container` rather than `box`: the latter would clash with
  /// `std::boxed::Box` in generated Rust bindings.)
  ///
  /// Containers carry layout only — no `style` field; how a host decorates
  /// one is a host concern, like focus. `direction` is the axis the children
  /// stack along; `align` is the cross axis it places them on (a column
  /// aligns its children horizontally, a row vertically). A host that cannot
  /// express a token renders without it, as with `style`.
  ///
  /// A container's `id` is *required in practice* (see the identity note
  /// above). A host that sees a child with a parent it does not have will
  /// treat the child as a root.
  record container {
    id: option<u32>,
    parent: option<u32>,
    direction: direction,
    align: align,
  }

  enum direction {
    row,
    column,
  }

  /// How a container places its children along the cross axis. Each host maps
  /// the tokens onto its own layout; a host that cannot express a token
  /// renders without it (the default is `center`).
  enum align {
    /// The start of the cross axis (left for a column, top for a row).
    start,
    /// The middle of the cross axis.
    center,
    /// The end of the cross axis (right for a column, bottom for a row).
    end,
  }

  variant node {
    text(text),
    button(button),
    container(container),
    input(input),
  }

  /// The `changed` mutation's payload: the node, plus its `index` — the
  /// node's 0-based position among its parent's children in the component's
  /// tree (0 for a root). The host places a new or re-parented node at that
  /// index among the parent's children, clamped to the parent's current
  /// children (0 is the front, the newest-first slot); a node keeping its
  /// parent is replaced in place and the index is ignored.
  record changed {
    node: node,
    index: u32,
  }

  /// One entry of a `changes` diff (see the `app` world): what is new for
  /// the host since it last saw the tree.
  ///
  /// A `changed` mutation is placed as its `changed` record documents. A
  /// `removed` id deletes a node — and, if it is a container, the whole
  /// subtree under it. Deeper restructuring is composed from these: a
  /// component that moves a container should remove the subtree and re-add
  /// it, since the flat pre-order list gives each retained node a stable
  /// home. A `changed` mutation for an id-less node is unaddressable (see
  /// the identity note above): hosts may ignore it.
  variant mutation {
    changed(changed),
    removed(u32),
  }
}
